# Normalize text files to LF in the repo; let Git decide what's text
* text=auto

# Force LF in the working tree for things that must be LF on every OS
*.sh      text eol=lf
*.py      text eol=lf
*.go      text eol=lf
Makefile  text eol=lf

# Force CRLF for things that need it on Windows
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binaries: never touch
*.png     binary
*.jpg     binary
*.zip     binary
*.dll     binary
*.exe     binary
